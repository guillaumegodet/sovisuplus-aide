---
// Starlight override: default title (logo + « Aide ») followed by the SoVisu+ version this help describes,
// so that every page states it once, in the same place.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { SOVISUPLUS_VERSION } from '../lib/version';
import { STRINGS, asHelpLang } from '../lib/i18n';

const lang = asHelpLang(Astro.locals.starlightRoute.lang);
---

<Default />
<span class="aide-version" title={STRINGS[lang].versionTitle}>
	SoVisu+ {SOVISUPLUS_VERSION}
</span>

<style>
	.aide-version {
		flex-shrink: 0;
		margin-inline-start: 0.75rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid rgb(255 255 255 / 0.6);
		border-radius: 999px;
		color: #ffffff;
		font-size: var(--sl-text-xs);
		font-weight: 500;
		white-space: nowrap;
	}
</style>
